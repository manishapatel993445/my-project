# =============================================
# ADMIN CREDENTIALS — set these before hosting
# =============================================
ADMIN_USER=admin
ADMIN_PASS=YourStrongPassword123

# =============================================
# JWT SECRET — use a long random string
# =============================================
JWT_SECRET=change-this-to-a-random-secret-string-minimum-32-chars

# =============================================
# SERVER PORT (Render/Railway use 3000 by default)
# =============================================
PORT=3000
